# Copy to .env for local use, or set these in the Render dashboard for a deployment.

# Required. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Required for any non-local deployment: the shared password coworkers type in.
# The server refuses to start on a public address without it.
# APP_PASSWORD=choose-a-shared-secret

# Optional
# PORT=5178                    # host platforms set this themselves
# HOST=0.0.0.0                 # set automatically on Render; loopback otherwise
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# CHUNK_SECONDS=420            # shorten if a hosting proxy times out long requests
# DIARIZE_CHUNK_SECONDS=120
